# Copy to .env and fill in. NEVER commit the real values.
#
# Both are created on the Cin7 Core API setup page:
#   https://inventory.dearsystems.com/ExternalAPI
#
# Cin7's own documentation is explicit that these are equivalent to a login
# and password. Treat them as such: secret store or CI secrets, never a file
# in the repo.

CIN7_ACCOUNT_ID=
CIN7_APP_KEY=

# Optional. Overrides the base URL, e.g. for a sandbox account.
# CIN7_BASE_URL=https://inventory.dearsystems.com/ExternalApi/v2
